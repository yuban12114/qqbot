# ---- 本地虚拟环境 ----
venv/
.venv/
env/

# ---- Python 字节码 ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 运行时数据（可再生产物）----
cache/*
!cache/.gitkeep
downloads/*
!downloads/.gitkeep
memory.json
memory.json.bak-*
*.log

# ---- 敏感配置（含明文 API Key / WS Token）----
config.json
config.json.bak*

# ---- NapCat 容器持久化（登录态 / 配置）----
napcat/

# ---- docker compose 备份 ----
docker-compose-backup.yml

# ---- 测试产物 ----
*.result.json

# ---- 部署打包产物 ----
qqbot-update-*.tar.gz

# ---- 部署前手工备份快照 ----
# 覆盖文件前用 cp 留的临时副本（如 agent.py.bak-20261028-185746）。
# 内容在 git 历史里都有，提交进来只会污染搜索、让仓库里出现两份同名模块。
*.bak
*.bak-*
*.bak.*

# ---- 系统文件 ----
.DS_Store
Thumbs.db
