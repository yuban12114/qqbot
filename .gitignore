# ---- 本地虚拟环境 ----
venv/
.venv/
env/

# ---- Python 字节码 ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 运行时数据（可再生产物）----
cache/*
!cache/.gitkeep
downloads/*
!downloads/.gitkeep
memory.json
memory.json.bak-*
*.log

# ---- 敏感配置（含明文 API Key / WS Token）----
config.json
config.json.bak*

# ---- NapCat 容器持久化（登录态 / 配置）----
napcat/

# ---- 测试产物 ----
*.result.json

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- docker-compose备份 ----
docker-compose-backup.yml