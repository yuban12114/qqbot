# 运行时数据与本地环境，不进镜像
venv/
__pycache__/
*.pyc
*.pyo
cache/
downloads/
napcat/

# 含明文 API key，靠 compose 挂载注入
config.json
memory.json

# 部署前手工备份快照（如 agent.py.bak-*）
# Dockerfile 末尾是 COPY . .，不加这条会把备份文件一起打进 /app
*.bak
*.bak-*
*.bak.*

# 测试与文档（不影响运行，减少镜像体积）
test_*.py
verify_*.py
setup.sh
*.md
.git/
.gitignore
